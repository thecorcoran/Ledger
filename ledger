#!/usr/bin/env bash
# Loretta's Ledger — Easy Control Script

set -e
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$DIR"

case "$1" in
  run|all)
    python3 -m pipeline
    ;;
  web|serve|dashboard|review)
    python3 -m pipeline.view --serve
    ;;
  push|publish)
    echo "Staging approved briefs and public site updates..."
    git add docs/ site/_site/
    git add -u ':!data/**'
    if git diff --staged --quiet; then
      echo "No newly approved drafts to commit."
    else
      git commit -m "Publish approved policy briefs and site updates"
    fi
    echo "Pushing to public website repository..."
    git push origin main
    ;;
  test)
    python3 -m unittest discover tests
    ;;
  *)
    echo "Loretta's Ledger"
    echo "Here are the three commands you need:"
    echo ""
    echo "  ./ledger run    - Check for new items and build drafts"
    echo "  ./ledger web    - Open the review page on your computer (http://localhost:8000)"
    echo "  ./ledger push   - Publish your approved drafts to the public website"
    echo ""
    ;;
esac
